<% content_for :title, "Messages" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>


<%= turbo_frame_tag :messages do %> 
  <%= turbo_frame_tag :new_message do  %> 
   <div class="flex justify-between items-center">
     <h1 class="font-bold text-4xl">Messages</h1>
     <%= link_to "New message", new_chat_message_path(@chat), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
   </div>
 <% end %>

  <div id="messages" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @messages.any? %>
      <% @messages.each do |message| %>



        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render message %>
         
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No messages found.</p>
    <% end %>
  </div>
 <% end %>


</div>
